{
  "name": "font-kku",
  "version": "0.4.0",
  "description": "Browser library for decomposing Korean Hangul syllables into jamo and rendering them as stylable, repositionable glyph parts",
  "license": "MIT",
  "homepage": "https://github.com/tty-link/font-kku#readme",
  "bugs": {
    "url": "https://github.com/tty-link/font-kku/issues"
  },
  "main": "./font-kku.js",
  "types": "./font-kku.d.ts",
  "style": "./font-kku.css",
  "unpkg": "./font-kku.js",
  "jsdelivr": "./font-kku.js",
  "exports": {
    ".": {
      "import": {
        "types": "./font-kku.d.mts",
        "default": "./font-kku.mjs"
      },
      "require": {
        "types": "./font-kku.d.ts",
        "default": "./font-kku.js"
      },
      "default": "./font-kku.js"
    },
    "./font-kku.js": {
      "types": "./font-kku.d.ts",
      "default": "./font-kku.js"
    },
    "./font-kku.mjs": {
      "types": "./font-kku.d.mts",
      "default": "./font-kku.mjs"
    },
    "./ime": {
      "import": {
        "types": "./font-kku-ime.d.mts",
        "default": "./font-kku-ime.mjs"
      },
      "require": {
        "types": "./font-kku-ime.d.ts",
        "default": "./font-kku-ime.js"
      },
      "default": "./font-kku-ime.js"
    },
    "./font-kku-ime.js": {
      "types": "./font-kku-ime.d.ts",
      "default": "./font-kku-ime.js"
    },
    "./font-kku-ime.mjs": {
      "types": "./font-kku-ime.d.mts",
      "default": "./font-kku-ime.mjs"
    },
    "./export": {
      "import": {
        "types": "./font-kku-export.d.mts",
        "default": "./font-kku-export.mjs"
      },
      "require": {
        "types": "./font-kku-export.d.ts",
        "default": "./font-kku-export.js"
      },
      "default": "./font-kku-export.js"
    },
    "./font-kku-export.js": {
      "types": "./font-kku-export.d.ts",
      "default": "./font-kku-export.js"
    },
    "./font-kku-export.mjs": {
      "types": "./font-kku-export.d.mts",
      "default": "./font-kku-export.mjs"
    },
    "./fx": {
      "import": {
        "types": "./font-kku-fx.d.mts",
        "default": "./font-kku-fx.mjs"
      },
      "require": {
        "types": "./font-kku-fx.d.ts",
        "default": "./font-kku-fx.js"
      },
      "default": "./font-kku-fx.js"
    },
    "./font-kku-fx.js": {
      "types": "./font-kku-fx.d.ts",
      "default": "./font-kku-fx.js"
    },
    "./font-kku-fx.mjs": {
      "types": "./font-kku-fx.d.mts",
      "default": "./font-kku-fx.mjs"
    },
    "./font-kku.css": "./font-kku.css",
    "./font-kku-looks.css": "./font-kku-looks.css",
    "./font-kku-motion.css": "./font-kku-motion.css",
    "./profiles/*.css": "./profiles/*.css",
    "./profiles/*.svg": "./profiles/*.svg",
    "./profiles/*.jamo.js": "./profiles/*.jamo.js",
    "./spec/css-variables.json": "./spec/css-variables.json",
    "./spec/capabilities.json": "./spec/capabilities.json",
    "./spec/render-plan.json": "./spec/render-plan.json",
    "./spec/fonts.json": "./spec/fonts.json",
    "./spec/html-cases.json": "./spec/html-cases.json",
    "./spec/sprite-layout.json": "./spec/sprite-layout.json",
    "./spec/tables.json": "./spec/tables.json",
    "./spec/test-cases.json": "./spec/test-cases.json",
    "./spec/themes.json": "./spec/themes.json",
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "font-kku-text": "./bin/font-kku-text.js"
  },
  "files": [
    "font-kku.js",
    "font-kku.mjs",
    "font-kku.d.ts",
    "font-kku.d.mts",
    "font-kku-ime.js",
    "font-kku-ime.mjs",
    "font-kku-ime.d.ts",
    "font-kku-ime.d.mts",
    "font-kku-export.js",
    "font-kku-export.mjs",
    "font-kku-export.d.ts",
    "font-kku-export.d.mts",
    "font-kku-fx.js",
    "font-kku-fx.mjs",
    "font-kku-fx.d.ts",
    "font-kku-fx.d.mts",
    "font-kku.css",
    "font-kku-looks.css",
    "font-kku-motion.css",
    "profiles/",
    "bin/",
    "skills/font-kku-use/",
    "spec/fonts.json",
    "spec/css-variables.json",
    "spec/capabilities.json",
    "spec/render-plan.json",
    "spec/html-cases.json",
    "spec/sprite-layout.json",
    "spec/strokes.json",
    "spec/tables.json",
    "spec/test-cases.json",
    "spec/themes.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/font_kku.test.js tests/spec_parity.test.js tests/asset_sync.test.js tests/font_lint.test.js tests/font_studio_model.test.js tests/font_kku_ime.test.js tests/font_kku_export.test.js tests/font_kku_fx.test.js",
    "test:docs": "node scripts/check_markdown_links.js && node scripts/check_document_contracts.js",
    "verify": ".venv/bin/python scripts/verify.py",
    "verify:fast": "python3 scripts/verify.py --fast"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tty-link/font-kku.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "hangul",
    "korean",
    "jamo",
    "font",
    "typography",
    "decomposition",
    "web-components",
    "ime",
    "animation",
    "themes"
  ]
}
