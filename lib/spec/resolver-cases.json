    "case-origin8": { "ㄱ": "M10 10 H90 V90", "ㄴ": "M10 10 V90 H90", "ㅁ": "M10 10 H90 V90 H10 Z", "ㅅ": "M50 10 L10 90 M50 10 L90 90", "ㅇ": { "ellipse": [50, 50, 40, 40] },
      "ㆍ": "M40 50 H60", "ㅡ": "M10 50 H90", "ㅣ": "M50 10 V90" }
